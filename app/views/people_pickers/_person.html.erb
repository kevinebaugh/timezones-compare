<%# locals: (member:, checked:, label: member.label) %>
<label class="group-item person-pick" data-groups-filter-target="item" data-name="<%= [ member.label, member.display_name ].compact.join(" ").downcase %>">
  <input type="checkbox" name="p[]" value="<%= member.slack_user_id %>" <%= "checked" if checked %>
         data-action="people-pick#count">
  <%= avatar(member) %>
  <span class="min-w-0 flex-1">
    <span class="block truncate"><%= label %></span>
    <span class="block text-xs text-faint truncate" data-controller="zone-name" data-zone-name-tz-value="<%= member.tz %>"><%= member.zone_name %></span>
  </span>
</label>
