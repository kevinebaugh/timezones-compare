<% content_for :title, "timezones.compare · #{t("home.title")}" %>
<section class="max-w-2xl mx-auto pt-12 sm:pt-20 flex flex-col gap-6">
  <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight leading-tight"><%= t("home.headline") %><br><span class="text-muted"><%= t("home.headline_muted") %></span></h1>
  <p class="text-lg text-muted"><%= t("home.lede") %></p>

  <div class="flex flex-wrap gap-3">
    <%= button_to slack_sign_in_path, class: "btn btn-primary", style: "height: 2.75rem; padding: 0 1.25rem", data: { turbo: false } do %>
      <%= t("home.sign_in") %>
    <% end %>
    <% if DemoMode.enabled? %>
      <%= button_to t("home.try_demo"), demo_sign_in_path, class: "btn", style: "height: 2.75rem; padding: 0 1.25rem" %>
    <% end %>
  </div>

  <div class="flex flex-col gap-2 text-sm text-faint">
    <p><%= t("home.reads") %></p>
    <%# Workspaces that require app approval show "Request to install" instead of signing in. %>
    <p class="admin-note"><%= t("home.admin_note_html", url: security_path(anchor: "for-admins")) %></p>
  </div>
</section>

<section class="home-preview-wrap" aria-label="<%= t("home.live_example") %>">
  <%= render "home/preview", grid: HomePreview.grid(HomePreview::DEFAULT_TZ) %>
</section>
