# From your Slack app's "Basic Information" page (see slack-manifest.yml).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Optional. The public address, used for link previews. Defaults to the
# host that served each request.
# APP_URL=https://timezones.compare

# Optional. Without Slack credentials (or with FAKE_SLACK=1), development
# offers a "Try the demo" sign-in with seeded people.
FAKE_SLACK=1

# Production only. Generate with `bin/rails secret`. Slack tokens are
# encrypted with keys derived from this unless you set the
# ACTIVE_RECORD_ENCRYPTION_* variables explicitly.
SECRET_KEY_BASE=
